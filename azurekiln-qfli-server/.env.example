# 服务端口
PORT=3000
NODE_ENV=production

# JWT 签名密钥（生产环境务必修改）
QFLI_JWT_SECRET=

# ---- 数据库：默认使用 MySQL ----
DB_DRIVER=mysql
# SQLite 模式可指定数据库目录（默认 ./data）
QFLI_DATA_DIR=

# MySQL 模式（DB_DRIVER=mysql 时生效，无需本地数据库文件，首次启动自动建表）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=qfli
MYSQL_PASSWORD=
MYSQL_DATABASE=qfli
MYSQL_POOL_SIZE=10

# 对外可见的基础地址（未配置时按请求推导，仅影响 OAuth2 回调地址）
PUBLIC_BASE_URL=https://qfli.suanxiwanjie.cn

# ---- 必填：实际网关地址和客户端凭据，只放在后端 ----
AZK_OAUTH2_BASE_URL=
AZK_OAUTH2_CLIENT_ID=
AZK_OAUTH2_CLIENT_SECRET=
AZK_OAUTH2_REDIRECT_URI=https://qfli.suanxiwanjie.cn/api/auth/oauth2/callback
AZK_OAUTH2_SCOPE=openid profile email phone roles offline_access

# 永久注销：调用网关统一账号注销接口需要的客户端凭据 scope。
# 网关管理员需给 qfli 客户端授予 qfli_account_erase，否则注销返回 403。
AZK_OAUTH2_ERASE_SCOPE=qfli_account_erase

# 审计去标识化盐值。更换后历史摘要无法再与新行归并，但不需要重新计算。
# 留空时使用内置固定盐（可接受，但建议生产环境单独配置）。
QFLI_AUDIT_SALT=

# 当前软件的第三方登录配置公共前缀。qfli + huawei -> qfli_huawei。
# 网关中对应配置的标识需与拼接结果一致；留空则由网关自动选择。
AZK_PROVIDER=qfli

# 独立安全终端服务，仅允许本机 HTTP 或证书有效的 HTTPS；未配置时禁止执行。
# 与执行服务使用同一随机密钥，不得复用 JWT / OAuth / MySQL 密钥。
QFLI_TERMINAL_URL=http://127.0.0.1:3101
QFLI_TERMINAL_SECRET=

# 云 MySQL 练习库：独立 mysqld（deployment/sqlbox/bootstrap.sh 生成并追加），
# 仅本机 Unix socket，与上面的业务 MySQL 隔离。未配置时 /api/sql 返回 503。
QFLI_SQLBOX_SOCKET=
QFLI_SQLBOX_ADMIN_PASSWORD=
QFLI_SQLBOX_USER_SECRET=

# ---- AI 编程助手：服务端固定上游，客户端不能覆盖地址、密钥或模型 ----
# OpenAI 兼容根地址，可带 /v1 前缀。密钥只放后端，禁止写入客户端与日志。
QFLI_AI_BASE_URL=https://newapi.azurekiln.cn
QFLI_AI_API_KEY=
QFLI_AI_MODEL=deepseek-v4.1-flash
# 可选：请求超时（毫秒，100-120000）、每用户每分钟次数、每用户并发、全服务在途上限。
QFLI_AI_TIMEOUT_MS=60000
QFLI_AI_RATE_LIMIT=20
QFLI_AI_CONCURRENCY=2
QFLI_AI_MAX_INFLIGHT=16

# ---- 内容审核服务（W1 azurekiln-moderation）：QFLI 只做接入，判定在服务端 ----
# 未配置时发布类请求一律 503 moderation.unavailable（failClosed），查询类不受影响。
# MODERATION_BASE_URL 必须是证书有效的 HTTPS（本机开发可用回环 HTTP）。
# apiKey 用于审核检查与举报；adminKey 只用于词库、IP 规则、先审后发等管理接口。
MODERATION_BASE_URL=
MODERATION_APP_ID=qflistudio
MODERATION_API_KEY=
MODERATION_ADMIN_KEY=
# 单次调用超时（毫秒，500-30000）。超时按不可用处理。
MODERATION_TIMEOUT_MS=3000

# ---- 发布限流（按用户，分钟窗口 + 自然日窗口，计数落库，重启不清零）----
PUBLISH_RATE_PER_MINUTE=3
PUBLISH_RATE_PER_DAY=20
COMMENT_RATE_PER_MINUTE=10
COMMENT_RATE_PER_DAY=100

# ---- 独立镜像部署（容器编排，追加段）----
# 业务容器使用 host 网络，上面的 127.0.0.1 MySQL、练习库 socket 与终端地址保持不变。
# 容器内数据目录固定为 /app/data，由 compose 挂载 ./data；QFLI_DATA_DIR 被覆盖。
# 业务容器不挂载 Docker socket。更新范围 qfli-server 与终端执行器互不影响。
# 可选：容器运行用户（默认 1000）。迁移既有 root 数据目录时先执行 chown。
# QFLI_SERVER_UID=1000
# QFLI_SERVER_GID=1000

# 终端执行节点池（多机扩展）。留空时回退到上面的单节点地址与密钥。
# JSON 数组，每项 {id,url,secret,draining?}。id 稳定唯一，secret 每节点独立，
# url 规则与单节点相同（本机 HTTP 或证书有效的 HTTPS）。
# 轮换或删除节点时保留未完成的预留，不重放旧命令。
# QFLI_TERMINAL_NODES=[]
