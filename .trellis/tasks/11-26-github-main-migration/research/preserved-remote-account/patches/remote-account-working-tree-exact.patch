+  windows:
+    name: Windows ${{ matrix.arch }} installer
+    needs: resolve-flutter
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - arch: x64
+            runner: windows-2022
