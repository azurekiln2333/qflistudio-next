+        run: flutter test --no-pub --reporter json 2>&1 | tee "$RUNNER_TEMP/flutter-test.json"
+
+      - name: Upload verification logs
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: verification-flutter-${{ matrix.package }}
+          path: |
+            ${{ runner.temp }}/flutter-analyze.log
+            ${{ runner.temp }}/flutter-test.json
+          if-no-files-found: warn
+          retention-days: 14
+
+  verify-java-interop:
+    name: Verify pinned Java foreground receiver
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    defaults:
+      run:
+        shell: bash
+        working-directory: qfli_java
+    steps:
+      - name: Check out the Java receiver
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
