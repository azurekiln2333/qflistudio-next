+            exit /b 1
+          )
+
+      - name: Set up Node for desktop companion packaging
+        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: ${{ env.COMPANION_NODE_VERSION }}
+
+      - name: Stage the installed Windows companion
+        shell: pwsh
+        run: |
+          ./tool/ci/stage_desktop_companion.ps1 -Os windows -Arch $env:ARCH `
+            -NodeVersion $env:COMPANION_NODE_VERSION -AppVersion $env:APP_VERSION `
+            -Destination (Join-Path $env:RELEASE_DIR 'companion')
+
+      - name: Locate MSVC inspection tools and runtime
+        run: |
+          temp="$(cygpath -m "$RUNNER_TEMP")"
+          # vswhere has one fixed location on every Visual Studio 2017+ machine.
+          vswhere="/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
+          if [ ! -f "$vswhere" ]; then
+            echo "::error::vswhere.exe is missing from the Visual Studio Installer directory"
+            exit 1
+          fi
+          if [ "$ARCH" = "arm64" ]; then
+            tools_component="Microsoft.VisualStudio.Component.VC.Tools.ARM64"
+          else
+            tools_component="Microsoft.VisualStudio.Component.VC.Tools.x86.x64"
+          fi
+          vs_property() {
+            "$vswhere" -latest -products '*' $2 \
+              -property "$1" 2> /dev/null | tr -d '\r' | sed -n '1p'
+          }
+          vs_install="$(vs_property installationPath "-requires $tools_component" || true)"
+          if [ -z "$vs_install" ]; then
+            # The component id is a preference. The toolset layout below decides.
+            echo "::warning::No Visual Studio reports $tools_component; falling back to the latest install"
+            vs_install="$(vs_property installationPath '' || true)"
+          fi
+          if [ -z "$vs_install" ]; then
+            echo "::error::vswhere found no Visual Studio installation"
+            exit 1
+          fi
+          vs_root="$(cygpath -m "$vs_install")"
+          defaults_dir="$vs_root/VC/Auxiliary/Build"
+
+          if [ ! -f "$defaults_dir/Microsoft.VCToolsVersion.default.txt" ]; then
+            echo "::error::Microsoft.VCToolsVersion.default.txt is missing from $defaults_dir"
+            exit 1
+          fi
+          tools_version="$(tr -d '\r\n ' < "$defaults_dir/Microsoft.VCToolsVersion.default.txt")"
+          # An arm64 host uses Hostarm64/arm64. A cross-toolchain may live one
+          # directory over, so both layouts are tried.
+          dumpbin=""
+          for host in "$ARCH" x64; do
+            candidate="$vs_root/VC/Tools/MSVC/$tools_version/bin/Host$host/$ARCH/dumpbin.exe"
+            if [ -f "$candidate" ]; then
+              dumpbin="$candidate"
+              break
+            fi
+          done
+          if [ -z "$dumpbin" ]; then
+            echo "::error::dumpbin.exe for $ARCH is missing from MSVC toolset $tools_version"
+            exit 1
+          fi
+
+          # Flutter does not bundle the MSVC runtime. Take it from the
+          # redistributable directory of this Visual Studio.
+          redist_default=""
+          if [ -f "$defaults_dir/Microsoft.VCRedistVersion.default.txt" ]; then
+            redist_default="$(tr -d '\r\n ' < "$defaults_dir/Microsoft.VCRedistVersion.default.txt")"
+          fi
+          crt_dir=""
+          # Keep the CRT wildcard outside quotes so the default can match.
+          for candidate in "$vs_root/VC/Redist/MSVC/$redist_default/$ARCH"/Microsoft.VC*.CRT; do
+            if [ -f "$candidate/msvcp140.dll" ] && [ -f "$candidate/vcruntime140.dll" ]; then
+              crt_dir="$candidate"
+              break
+            fi
+          done
+          if [ -z "$crt_dir" ]; then
