+          entry.ws.terminate();
+        }
+        closed++;
+      }
+      log.info('closed clients after revocation', { accountId, deviceId, closed });
+      return closed;
+    },
+
+    closeDeviceClients(deviceId) {
+      let closed = 0;
+      bumpFence(deviceId);
+      for (const [clientId, entry] of clientBook) {
+        if (entry.agentId !== deviceId) continue;
+        clientBook.delete(clientId);
+        const agent = agents.get(entry.agentId);
+        agent?.clients.delete(clientId);
+        try {
+          entry.ws.close(CLOSE_POLICY, 'device revoked');
+        } catch {
+          entry.ws.terminate();
+        }
+        closed++;
+      }
+      log.info('closed clients after device revocation', { deviceId, closed });
+      return closed;
+    },
+
+    closeLegacyClients(deviceId) {
+      let closed = 0;
+      bumpFence(deviceId);
+      for (const [clientId, entry] of clientBook) {
+        if (entry.agentId !== deviceId || entry.accountId !== null) continue;
+        clientBook.delete(clientId);
+        const agent = agents.get(entry.agentId);
+        agent?.clients.delete(clientId);
+        try {
+          // This client was admitted with the device secret, which no longer
+          // authorizes anything now that the device is account-managed.
+          entry.ws.close(CLOSE_POLICY, 'device now requires account authorization');
+        } catch {
+          entry.ws.terminate();
+        }
+        closed++;
+      }
+      log.info('closed legacy clients after first account binding', { deviceId, closed });
+      return closed;
+    },
+
+    invalidateDevice(deviceId) {
+      accounts.invalidateDevice?.(deviceId);
+      // Same split as `invalidateBinding`: `closeDeviceClients` (or
+      // `closeLegacyClients`) performs the fence bump for this mutation.
     },
   };
 }
