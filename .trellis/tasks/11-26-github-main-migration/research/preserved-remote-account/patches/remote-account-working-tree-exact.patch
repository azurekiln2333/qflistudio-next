+// Adapters from the real Agent SDK to the structural types AgentCore uses.
+
+import { getSessionMessages, listSessions, query } from '@anthropic-ai/claude-agent-sdk';
+
+import type { HistoryLoader } from './core.ts';
+import type { QueryFn, QueryHandle } from './session.ts';
+import type { HistoryItem } from '../shared/protocol.ts';
+
+const PHONE_HISTORY_LIMIT = 30;
+const DESKTOP_HISTORY_PAGE_SIZE = 100;
+const MAX_DESKTOP_HISTORY_PAGES = 100;
+
+function toHistoryItems(sessions: Awaited<ReturnType<typeof listSessions>>): HistoryItem[] {
+  return sessions.map((s) => ({
+    sessionId: s.sessionId,
+    summary: s.customTitle || s.summary || s.firstPrompt || s.sessionId,
+    cwd: s.cwd,
+    lastModified: s.lastModified,
+  }));
+}
+
+/** Lists a bounded desktop history page set for one configured root. */
+export async function listDesktopClaudeHistory(cwd?: string): Promise<HistoryItem[]> {
+  const all: Awaited<ReturnType<typeof listSessions>> = [];
+  for (let page = 0; page < MAX_DESKTOP_HISTORY_PAGES; page += 1) {
+    const sessions = await listSessions({
+      dir: cwd,
+      limit: DESKTOP_HISTORY_PAGE_SIZE,
+      offset: page * DESKTOP_HISTORY_PAGE_SIZE,
+    });
+    all.push(...sessions);
+    if (sessions.length < DESKTOP_HISTORY_PAGE_SIZE) break;
+  }
+  return toHistoryItems(all);
+}
+
+export function sdkQueryFn(onStderr?: (line: string) => void): QueryFn {
+  return ({ prompt, options }) =>
+    query({
+      // Our message/permission shapes are structural subsets of the SDK's.
+      prompt: prompt as unknown as Parameters<typeof query>[0]['prompt'],
+      options: {
+        ...options,
+        canUseTool: options.canUseTool as unknown as NonNullable<Parameters<typeof query>[0]['options']>['canUseTool'],
+        stderr: onStderr,
+      },
+    }) as unknown as QueryHandle;
+}
+
+export const sdkHistory: HistoryLoader = {
+  async list(cwd) {
+    const sessions = await listSessions({ dir: cwd, limit: PHONE_HISTORY_LIMIT });
+    return toHistoryItems(sessions);
+  },
+  async messages(claudeSessionId, cwd) {
+    return getSessionMessages(claudeSessionId, { dir: cwd });
+  },
+};
