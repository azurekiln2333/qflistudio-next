+// Outbound connection from the agent to the relay: hello/auth, message
+// routing into AgentCore, pairing codes, heartbeat watchdog and reconnect.
+
+import { randomInt } from 'node:crypto';
+import { WebSocket } from 'ws';
+
+
+import { sha256Hex } from '../shared/crypto.ts';
+import { type Logger, silentLogger } from '../shared/log.ts';
+import {
+  MAX_FRAME_BYTES,
+  PAIR_CODE_ALPHABET,
+  PAIR_CODE_LENGTH,
+  PROTOCOL_VERSION,
+  type AgentMessage,
+  type ClientMessage,
+} from '../shared/protocol.ts';
+import type { AgentCore } from './core.ts';
+
+export type RelayLinkOptions = {
+  url: string;
+  /** Phone-reachable relay URL used in pairing links. */
+  pairingUrl?: string;
+  agentId: string;
+  secret: string;
+  relayKey?: string;
+  name: string;
+  /**
+   * Optional device platform reported in the agent `hello` (`process.platform`).
+   *
+   * Optional in the relay protocol too, so an agent built before this field
+   * existed still connects, and the relay records the device row only when it
+   * receives one.
+   */
+  platform?: string;
+  core: AgentCore;
+  logger?: Logger;
+  onOnline?: () => void;
+  onOffline?: (reason: string) => void;
+  onPaired?: () => void;
+  /** Relay pings every 30 s; treat the link as dead after this much silence. */
+  watchdogMs?: number;
+};
+
+export type PairCode = { code: string; display: string; expiresAt: number };
+
+export function generatePairCode(): string {
+  let code = '';
+  for (let i = 0; i < PAIR_CODE_LENGTH; i++) code += PAIR_CODE_ALPHABET[randomInt(PAIR_CODE_ALPHABET.length)];
+  return code;
+}
+
+export function formatPairCode(code: string): string {
+  return `${code.slice(0, 4)}-${code.slice(4)}`;
+}
+
+export class RelayLink {
+  private readonly opts: RelayLinkOptions;
+  private readonly helloPlatform: string | undefined;
+
+  /**
+   * Relay this link is connected to.
+   *
+   * The pairing URI must name the same relay the code was requested from;
+   * anything else would hand the phone an address that does not know the code.
+   */
+  get url(): string {
+    return this.opts.url;
+  }
+
+  get pairingUrl(): string {
+    return this.opts.pairingUrl ?? this.opts.url;
+  }
+  private readonly log: Logger;
+  private ws: WebSocket | null = null;
+  private online = false;
+  private stopped = false;
+  private attempt = 0;
+  private reconnectTimer: NodeJS.Timeout | null = null;
+  private watchdog: NodeJS.Timeout | null = null;
+  private pairWaiters: Array<{ resolve(c: PairCode): void; reject(e: Error): void }> = [];
+  /** Detaches this link's sink from the core; null while stopped. */
+  private detachEmitter: (() => void) | null = null;
+
+  constructor(opts: RelayLinkOptions) {
+    this.opts = opts;
+    this.helloPlatform = opts.platform;
+    this.log = opts.logger ?? silentLogger;
+    // The sink is registered in start(), not here: an agent can hold several
+    // links at once (LAN + public relay), and attaching in the constructor
+    // would make the last-constructed link own every outbound frame.
+  }
+
+  get isOnline(): boolean {
+    return this.online;
+  }
+
+  start(): void {
+    this.stopped = false;
+    this.detachEmitter ??= this.opts.core.addEmitter((msg, to) => this.emit(msg, to));
+    this.connect();
+  }
+
+  stop(): void {
+    this.stopped = true;
+    // Detach before closing so no frame is queued onto a dying socket.
+    this.detachEmitter?.();
+    this.detachEmitter = null;
+    if (this.reconnectTimer) clearTimeout(this.reconnectTimer);
+    if (this.watchdog) clearTimeout(this.watchdog);
+    this.ws?.close(1000, 'agent shutting down');
+    this.ws = null;
+  }
+
+  /** Register a fresh one-time pairing code with the relay. */
+  requestPairCode(ttlMs = 10 * 60_000): Promise<PairCode> {
+    if (!this.online || !this.ws) return Promise.reject(new Error('not connected to relay'));
+    const code = generatePairCode();
+    this.ws.send(JSON.stringify({ t: 'pair_code', code, ttlMs }));
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error('relay did not confirm the pairing code')), 10_000);
+      this.pairWaiters.push({
