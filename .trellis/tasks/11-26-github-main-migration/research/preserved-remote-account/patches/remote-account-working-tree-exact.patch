+name: App installers
+
+# Builds installable packages for eleven targets on GitHub-hosted runners.
+# Every JavaScript action is pinned by commit and runs on Node 24, so no
+# "Node.js 20 is deprecated" warning appears. Preview publication requires
+# every verification job and installer target. No production signing key is used.
+
+on:
+  push:
+    branches:
+      - main
+      - "ci/**"
+      - "release/**"
+      - "remote/**"
+    tags:
+      - "v*"
+    paths:
+      - "lib/**"
+      - "assets/**"
+      - "windows/**"
+      - "linux/**"
+      - "macos/**"
+      - "ios/**"
+      - "android/**"
+      - "ohos/**"
+      - "pubspec.yaml"
+      - "pubspec.lock"
+      - "tool/ci/**"
+      - "companion/**"
+      - "test/**"
+      - ".github/**"
+  pull_request:
+    branches:
+      - main
+    paths:
+      - "lib/**"
+      - "assets/**"
+      - "windows/**"
+      - "linux/**"
+      - "macos/**"
+      - "ios/**"
+      - "android/**"
+      - "ohos/**"
+      - "pubspec.yaml"
+      - "pubspec.lock"
+      - "tool/ci/**"
+      - "companion/**"
+      - "test/**"
+      - ".github/**"
+  workflow_dispatch:
+    inputs:
+      flutter_version:
+        description: Official Flutter stable version. Empty uses the pinned release version.
+        required: false
+        default: ""
+      core_ref:
+        description: qflistudio-core branch, tag or commit. Empty uses the pinned release commit.
+        required: false
+        default: ""
+
+permissions:
+  contents: read
+
+concurrency:
+  group: app-installers-${{ github.ref }}
+  cancel-in-progress: true
+
+defaults:
+  run:
+    shell: bash
+    working-directory: qflistudio
+
+env:
+  # The app reads the core through path: ../qfli_studio_core, so both
+  # repositories are checked out as siblings inside the workspace.
+  OHOS_TOOLS_VERSION: "26.0.0.821"
+  OHOS_API_LEVEL: "26"
+  OHOS_FLUTTER_VERSION: "3.41.10-ohos-1.0.1"
+  OHOS_FLUTTER_COMMIT: "adaf911c35c9136a7d18fc424d714c9ec7724e60"
+  OHOS_NODE_VERSION: "24.14.1"
+  COMPANION_NODE_VERSION: "24.14.1"
