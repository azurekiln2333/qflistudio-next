+        with:
+          name: verification-java-interop
+          path: ${{ runner.temp }}/java-interop-tests.log
+          if-no-files-found: warn
+          retention-days: 14
+
+  verify-companion:
+    name: Verify Node companion on ${{ matrix.os }}
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 25
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, windows-2022, macos-15]
