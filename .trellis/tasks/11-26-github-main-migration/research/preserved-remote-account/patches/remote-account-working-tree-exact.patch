+const shutdown = () => {
+  if (shuttingDown) return;
+  shuttingDown = true;
+  detachLocal?.();
+  stopDetachedInput?.();
+  pairingInput?.close();
+  if (process.stdin.isTTY) process.stdin.setRawMode(false);
