+// The relay core under `src/` is a copy of the relay server repo (design §3).
+//
+// Nothing here should ever be edited in place: the relay server repo owns
+// `relay.ts`, `relay-protocol.ts`, `protocol-account.ts`, `crypto.ts` and
+// `log.ts`, and `relay-core.json` records the commit and hashes it was taken
+// from. This test fails when the copy drifts from that record.
+
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { test } from 'node:test';
+import { promisify } from 'node:util';
+
+import {
+  RELAY_CORE_FILES,
+  SERVER_DIR,
+  SYNC_HINT,
+  diffHashes,
+  hashAll,
+  hashContents,
+  provenanceProblems,
+  readManifest,
+  snapshotHash,
+  sourceManifest,
+} from '../scripts/sync-relay.ts';
+import type { RelayCoreManifest } from '../scripts/sync-relay.ts';
+
+test('the relay core copy matches relay-core.json', async () => {
+  const manifest = await readManifest();
+
+  assert.match(manifest.source, /^https:\/\/github\.com\//, `relay-core.json: unexpected source ${manifest.source}`);
+  assert.deepEqual(provenanceProblems(manifest), [], 'relay-core.json: invalid source provenance');
+
+  // A file added to one repo but forgotten here would otherwise never be checked.
+  assert.deepEqual(
+    Object.keys(manifest.files).sort(),
+    [...RELAY_CORE_FILES].sort(),
+    `relay-core.json: file list mismatch. ${SYNC_HINT}`,
+  );
+
+  const problems = diffHashes(manifest.files, await hashAll(SERVER_DIR));
+  assert.deepEqual(problems, [], `relay core copy is out of sync:\n${problems.join('\n')}\n${SYNC_HINT}`);
+});
+
+test('draft provenance binds every path and content hash and cannot pass a release gate', () => {
+  const files = Object.fromEntries(RELAY_CORE_FILES.map((file) => [file, hashContents(file)]));
+  const draft: RelayCoreManifest = {
+    source: 'https://github.com/example/relay',
+    commit: null,
+    base_commit: 'a'.repeat(40),
+    working_tree_sha256: snapshotHash(files),
+    files,
+  };
+  assert.deepEqual(provenanceProblems(draft), []);
+  assert.match(provenanceProblems(draft, true).join(' '), /cannot be released/);
+  const modified = { ...draft, files: { ...files, [RELAY_CORE_FILES[0]!]: hashContents('changed') } };
+  assert.match(provenanceProblems(modified).join(' '), /digest mismatch/);
+  const reordered = Object.fromEntries(Object.entries(files).reverse());
+  assert.equal(snapshotHash(reordered), draft.working_tree_sha256);
+  const mixed = { ...draft, commit: 'a'.repeat(40) } as unknown as RelayCoreManifest;
+  assert.match(provenanceProblems(mixed).join(' '), /cannot be mixed/);
+});
+
+test('synchronizing changed source requires an explicit draft and records its actual base', async (t) => {
+  const fixture = await mkdtemp(path.join(os.tmpdir(), 'relay-provenance-'));
+  t.after(() => rm(fixture, { recursive: true, force: true }));
+  const run = promisify(execFile);
+  const git = (...args: string[]) => run('git', ['-C', fixture, ...args]);
+  for (const file of RELAY_CORE_FILES) {
+    await mkdir(path.dirname(path.join(fixture, file)), { recursive: true });
+    await writeFile(path.join(fixture, file), `// ${file}\n`);
+  }
+  await git('init');
+  await git('add', '--', ...RELAY_CORE_FILES);
+  await git('-c', 'user.name=fixture', '-c', 'user.email=fixture@example.invalid', '-c', 'commit.gpgsign=false', 'commit', '-m', 'fixture');
+  const clean = await sourceManifest(fixture, await hashAll(fixture));
+  assert.match(clean.commit ?? '', /^[0-9a-f]{40}$/);
+
+  const changed = path.join(fixture, RELAY_CORE_FILES[0]!);
+  await writeFile(changed, `${await readFile(changed, 'utf8')}// uncommitted change\n`);
+  const hashes = await hashAll(fixture);
+  await assert.rejects(sourceManifest(fixture, hashes), /differs from HEAD/);
+  const draft = await sourceManifest(fixture, hashes, true);
+  assert.equal(draft.commit, null);
+  assert.equal(draft.base_commit, clean.commit);
+  assert.equal(draft.working_tree_sha256, snapshotHash(hashes));
+  assert.deepEqual(provenanceProblems(draft), []);
+});
