+    env:
+      ARCH: ${{ matrix.arch }}
+      PE_MACHINE: ${{ matrix.machine }}
+      BUILD_DIR: build/windows/${{ matrix.arch }}
+      RELEASE_DIR: build/windows/${{ matrix.arch }}/runner/Release
