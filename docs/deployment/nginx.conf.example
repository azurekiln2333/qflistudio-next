# 部署示例：按服务器实际安装位置确认后端端口和证书路径后使用。
server {
    listen 80;
    server_name qfli.suanxiwanjie.cn;
    return 301 https://qfli.suanxiwanjie.cn$request_uri;
}

server {
    listen 443 ssl;
    server_name qfli.suanxiwanjie.cn;

    ssl_certificate /etc/letsencrypt/live/qfli.suanxiwanjie.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qfli.suanxiwanjie.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 8m;

    location /api/terminal/ {
        client_max_body_size 384k;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_ignore_client_abort off;
    }

    location /api/ {
        # 不加 URI 后缀，保留 /api/ 路径。
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # 官网页面请按实际部署另行配置；不要把 /api/ 路由落到 SPA 首页。
    location / {
        return 404;
    }
}
